GENESIS_SEED=42
GENESIS_DB=data/genesis.sqlite
GENESIS_ORIGINS=http://localhost:5173
GENESIS_INFINITE=1
GENESIS_ACTIVE_RADIUS=1
GENESIS_CACHE_SIZE=64

# Local everyday cognition (CPU only, one bounded batch at a time).
GENESIS_COGNITION=1
GENESIS_OLLAMA_URL=http://localhost:11435
GENESIS_LOCAL_MODEL=qwen2.5:0.5b
# Optional Ollama alternate: llama3.2:1b
GENESIS_COGNITION_INTERVAL=1
GENESIS_COGNITION_TTL=80
GENESIS_LLM_TIMEOUT=45

# Local generated conversations; independent of Laya goal selection.
GENESIS_DIALOGUE_TTL=240
GENESIS_DIALOGUE_TIMEOUT=90
GENESIS_DIALOGUE_PROVIDER=ollama
GENESIS_DIALOGUE_URL=http://localhost:11435/v1
GENESIS_DIALOGUE_MODEL=llama3.2:1b
GENESIS_DIALOGUE_API_KEY=

# Primary decisions: self-hosted Laya on CPU. Ollama stays optional.
GENESIS_DECISION_PROVIDER=laya
GENESIS_LAYA_URL=http://localhost:11437
GENESIS_LAYA_MODEL=convaiinnovations/laya-multilingual
GENESIS_LAYA_REVISION=1720e3e3357cfe1e281542e223f8273b0890ca34
